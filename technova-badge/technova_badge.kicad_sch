	(text
		"Notes"
		(exclude_from_sim no)
		(at 25.4 250.19 0)
		(effects (font (size 2 2)) (justify left bottom))
		(uuid "f3aad8ae-4f74-428e-aa1c-7288d15da6ab")
	)
	(text
		"3V3: AP2112K-3.3 LDO after the power switch, feeds the MCU, NFC chip, OLED logic and pull-ups."
		(exclude_from_sim no)
		(at 25.4 256.54 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "1def564f-9148-49e7-8b88-377908c8466f")
	)
	(text
		"NFC: 42 mm coil on B.Cu (2.78 uH) with the NT3H2111 50 pF tunes to 13.56 MHz. C15 is an optional tuning spot (DNP)."
		(exclude_from_sim no)
		(at 25.4 261.62 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "f5d30245-c2c1-486c-a857-fb35ed7e014a")
	)
	(text
		"OLED: ER-OLED013A1-1W (SSD1306) in a FH12-30S ZIF, I2C mode (BS0=0 BS1=1 BS2=0, D/C#=0), address 0x3C."
		(exclude_from_sim no)
		(at 25.4 265.43 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "4ebe6486-3d23-4538-bbd0-2c24fb0fe611")
	)
	(text
		"MCU: PD0/PD1 used as GPIO for CHRG and NFC_FD, I2C bit-banged on PA5/PA6, LED data on PA7. Program over SWD or the USB bootloader."
		(exclude_from_sim no)
		(at 25.4 270.51 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "3c9f40f4-9de9-4d0a-8263-0d6e0a76ae09")
	)
	(text
		"Battery sense: VBAT_SENSE = VDD/2 on PA4 (ADC4)."
		(exclude_from_sim no)
		(at 25.4 275.59 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "e4c5c7cc-361f-42fa-a796-71c8fef8c0a6")
	)
	(text
		"Assembly: the LiPo sits on the back over the NFC coil, with a ~45 mm ferrite sheet between battery and board."
		(exclude_from_sim no)
		(at 25.4 280.67 0)
		(effects (font (size 1.27 1.27)) (justify left bottom))
		(uuid "d0d057b5-3fb6-49ca-ad8f-3af185d134d5")
	)
